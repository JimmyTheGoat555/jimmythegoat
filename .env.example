# Copy this file to .env.local and fill in the values from your Firebase
# project's web app config (Firebase Console → Project settings → General →
# "Your apps" → SDK setup and configuration → Config).
#
# These are safe to expose in client code — they identify the project, they
# don't grant access. Real access control lives in firestore.rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=

# Push notifications only (weekly weigh-in reminders, trainer weigh-in
# updates) — everything else above works without these.
# MESSAGING_SENDER_ID: Firebase Console → Project settings → Cloud Messaging
# tab → "Sender ID" (same as your project number).
# VAPID_KEY: same Cloud Messaging tab → "Web configuration" → generate a
# key pair if one doesn't exist yet → copy the "Key pair" value.
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_VAPID_KEY=

# App Check (optional, recommended before a public launch). A reCAPTCHA v3
# site key: Firebase Console → App Check → apps list → register this web
# app → "reCAPTCHA v3" provider → paste the site key here. Leave blank and
# App Check stays off (the app is unchanged). See src/lib/firebase.js for
# the two-step rollout once it's set. Local dev needs a debug token —
# instructions are in that same comment.
VITE_FIREBASE_APPCHECK_SITE_KEY=

# Crash reporting (optional). Leave blank and Sentry stays off entirely —
# no reporting, no errors, the app is unchanged. The DSN is safe to expose;
# it identifies the project and grants nothing. Sentry → Settings →
# Projects → [project] → Client Keys.
VITE_SENTRY_DSN=

# Source-map upload, build machines only. NOT listed with a VITE_ prefix on
# purpose: Vite inlines every VITE_ variable into the client bundle, and
# this one is a real secret (Sentry → Settings → Auth Tokens, scope
# project:releases). Without it the build still succeeds, it just uploads
# nothing and stack traces in Sentry stay minified.
#   SENTRY_AUTH_TOKEN=
# Set these two only if the Sentry slugs differ from the defaults in
# vite.config.js.
#   SENTRY_ORG=
#   SENTRY_PROJECT=
