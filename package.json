{
  "name": "jimmy-the-goat",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "test:progression": "node --test tools/progression.test.mjs",
    "test:badges": "node --test tools/badges.test.mjs",
    "test": "node --test tools/progression.test.mjs tools/badges.test.mjs tools/setLoad.test.mjs tools/leaderboard.test.mjs tools/jimmyWorkouts.test.mjs",
    "preview": "vite preview",
    "deploy:functions": "firebase deploy --only functions,firestore:rules --project jimmy-the-goat",
    "build:ios": "vite build && npx cap sync ios",
    "open:ios": "npx cap open ios",
    "ios": "npm run build:ios && npm run open:ios"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.1.0",
    "@capacitor-firebase/messaging": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/local-notifications": "^8.3.1",
    "canvas-confetti": "^1.9.4",
    "firebase": "^12.18.0",
    "lucide-react": "^1.42.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "recharts": "^3.10.1",
    "workbox-routing": "^7.4.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.5.5",
    "firebase-tools": "^15.30.2",
    "oxlint": "^1.79.0",
    "postcss": "^8.5.28",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-precaching": "^7.4.1"
  }
}
